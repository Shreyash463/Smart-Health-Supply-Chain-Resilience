# Gemini API Key (Required for AI redistribution alerts)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# Server Port and Host
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Firebase Firestore Configuration (Optional)
# Leave blank to use built-in resilient local storage engine
# Or provide absolute path to serviceAccountKey.json or raw JSON string
FIREBASE_SERVICE_ACCOUNT_JSON=
